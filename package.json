{
  "name": "aios-marketing",
  "version": "0.0.0",
  "private": true,
  "description": "AIOS content-marketing system. Not a published package — package.json exists only to give the repo's one executable a test + coverage entry point.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "npm ci --ignore-scripts",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:coverage": "c8 --reporter=text --reporter=json-summary --reporter=lcov --include='.agents/skills/**/*.mjs' node --test \"test/**/*.test.mjs\"",
    "lint:shell": "shellcheck --severity=warning $(git ls-files '*.sh')",
    "leak-gate": "bash scripts/leak-gate.sh ."
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
